{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "UDMC Control",
  "version": "0.24.0",
  "identifier": "dev.udmc.control",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UDMC Control",
        "theme": "Dark",
        "dragDropEnabled": false,
        "width": 1240,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://*:* https://*:*; img-src 'self' data: https://cdn.modrinth.com https://media.forgecdn.net; style-src 'self'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0RDQyMUI3NTMyNDdBNDYKUldSR2VpUlR0eUhVTkw4M2RwU0VFcy9rcUNLK25KVEZRdkQ4YnE1QXdCcFY2bXZubHZnMEE1V2sK",
      "endpoints": [
        "https://github.com/metraveer/udmc/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}
