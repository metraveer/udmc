{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:udmc-sync:manifest:v1",
  "title": "UDMC Manifest",
  "type": "object",
  "required": ["schemaVersion", "pack", "minecraft", "publishedAt", "files"],
  "properties": {
    "releaseSequence": { "type": "integer", "minimum": 0 },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "pack": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "minecraft": {
      "type": "object",
      "required": ["version", "loader"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "loader": {
          "type": "object",
          "required": ["type", "version"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["fabric", "forge", "neoforge", "quilt", "vanilla"]
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "side", "sha256", "size", "downloadPath", "updatedAt"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(mods|config|resourcepacks|shaderpacks)/.+$"
          },
          "side": {
            "type": "string",
            "enum": ["client", "server", "both"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "downloadPath": {
            "type": "string",
            "pattern": "^/files/[a-f0-9]{64}(\\.[A-Za-z0-9_-]{1,16})?$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
